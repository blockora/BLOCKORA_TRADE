# BLOCKORA_TRADE Environment Configuration
# Copy this file to .env and fill in your credentials

ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_here

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

DATABASE_PATH=./database/blockora_trade.db
LOG_LEVEL=INFO
MODE=production
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
UPI_ID=yourname@upi

# Optional (has safe defaults)
INSTRUMENT_URL=
SUBSCRIPTION_PRICE=499
